# ==============================================================================
#  Settings of the demo's compose files (optional: every variable has a default).
#  Copy to demo/.env, next to the compose files.
#
#  The model endpoints are NOT here: they belong to the system and live in ../.env (see ../.env.example).
#  Compose passes that file to the backend; endpoints on localhost / 127.0.0.1 are rewritten to
#  host.docker.internal inside the container.
# ==============================================================================

# ---- ports
FRONTEND_PORT=8795
# bound to 127.0.0.1: Swagger at http://localhost:8796/docs, and the Vite dev server's /api target
BACKEND_PORT=8796
# docker-compose.yml only: the demo's own Milvus, bound to 127.0.0.1 (19531, so it never clashes with 19530)
MILVUS_PORT=19531

# ---- docker-compose.server.yml only: the Milvus shared with other applications
# MILVUS_NETWORK=candor-net
# MILVUS_HOST=milvus-standalone
# MILVUS_DB=campusscope

LOG_LEVEL=INFO
TZ=Asia/Shanghai

# ---- package mirrors for building the images (e.g. in mainland China)
# PIP_INDEX_URL=https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple
# NPM_REGISTRY=https://registry.npmmirror.com
