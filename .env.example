# ==============================================================================
#  Model endpoints and Milvus for campusscope/, scripts/ and the demo backend.
#  Copy to .env at the repository root (git-ignored); the process environment wins over this file.
#  All model endpoints are OpenAI-compatible.
# ==============================================================================

# ---- backbone of every system (compiles the notices, plans and writes): DeepSeek-V4.1-Flash
# The LLM cache is keyed by the model id: keep the id of the paper's runs to replay the released cache.
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# ---- embeddings: bge-large-zh-v1.5 behind an OpenAI-compatible /embeddings endpoint
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-large-zh-v1.5
EMBEDDING_DIM=1024

# ---- benchmark construction only (scripts/prepare_corpus.py, scripts/build_benchmark.py)
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=
BONSAI_BASE_URL=
BONSAI_API_KEY=
BONSAI_MODEL=

# ---- Milvus used by scripts/ (the demo's compose files set their own)
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
# a database of its own when the Milvus instance is shared with other applications (created if missing)
MILVUS_DB=
